{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "../.tmp/lib",
    "rootDir": "..",
    "noEmit": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] },
    "types": ["node"]
  },
  "include": ["../src/**/*.ts", "../tests/**/*.ts"]
}
